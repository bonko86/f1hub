{
  "name": "f1-dashboard", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "tsx --test server/*.test.ts",
    "backup": "tsx --env-file-if-exists=.env server/backup.ts"
  },
  "dependencies": { "better-sqlite3": "^12.0.0", "express": "^5.0.0", "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": { "@types/better-sqlite3": "^7.6.0", "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^5.0.0", "tsx": "^4.0.0", "typescript": "^5.9.0", "vite": "^7.0.0" }
}
